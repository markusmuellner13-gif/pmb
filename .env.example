# --- Database (Turso / libSQL) ---
# Create with: turso db create polybot && turso db tokens create polybot
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=

# --- Dashboard auth ---
# Password you type in to sign in to the dashboard.
DASHBOARD_PASSWORD=
# Random long string used to sign the session cookie. Generate with:
# openssl rand -hex 32
SESSION_SECRET=

# --- Cron trigger ---
# Random long string. GitHub Actions sends it as a bearer token to /api/cron/cycle.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# --- Polymarket live trading (optional, leave unset to stay in paper mode) ---
# Private key of the Polygon wallet you trade with. NEVER commit this value —
# set it only as a Vercel project environment variable.
POLYMARKET_PRIVATE_KEY=
# Your Polymarket "Profile Address" (the address you deposit USDC to).
POLYMARKET_FUNDER_ADDRESS=
# 0 = browser wallet (Metamask/Coinbase Wallet), 1 = email/Magic login wallet.
POLYMARKET_SIGNATURE_TYPE=1

# --- Optional overrides ---
# POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
# POLYMARKET_CLOB_URL=https://clob.polymarket.com
